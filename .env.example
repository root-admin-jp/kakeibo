# 実値はコミットしない（ADR-0005）。ダミー値だけを置く。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kakeibo
DB_USER=kakeibo
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme-root
JWT_SECRET=changeme-jwt-secret

# メール OTP の送信設定（ADR-0014）。log の間はコードを API のログに出力する（開発用）
MAIL_MODE=log
MAIL_FROM=noreply@example.com
# MAIL_MODE=smtp のときに使う SMTP サーバー
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# パスキー (WebAuthn) の RP 設定。本番では自分のドメインに合わせる（HTTPS 前提）
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Kakeibo
# WEBAUTHN_ORIGINS=http://localhost:3000
